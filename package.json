{
  "name": "moat-mcp",
  "version": "0.1.0",
  "description": "A security-hardened Postgres MCP server that governs safe, read-only access for LLM agents — read-only enforcement, SQL-AST inspection, table/column allow-listing, Row-Level Security, OAuth 2.1, and full query audit logging.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "moat-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev:stdio": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:redteam": "vitest run test/redteam.test.ts",
    "test:smoke": "npm run build && node scripts/query-tool-smoke.mjs",
    "test:smoke:oauth": "npm run build && node scripts/oauth-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "postgres",
    "model-context-protocol",
    "security",
    "sql-injection",
    "row-level-security",
    "oauth",
    "audit"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jose": "^5.0.0",
    "node-sql-parser": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

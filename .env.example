# moat-mcp configuration
# Copy to .env and adjust. NEVER commit .env.

# Database (dev defaults match docker-compose.yml)
DATABASE_URL=postgres://mcp_readonly:moat_readonly_dev@127.0.0.1:5432/moat_mcp

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_PORT=3333

# JWT validation
JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=moat-mcp
JWT_EXPIRES_IN_SEC=3600

# Signing secret. The server REFUSES TO START with NODE_ENV set to anything
# other than development while this is unset or left at the shipped default.
# JWT_SECRET=

# Resource limits (defence against denial of service)
STATEMENT_TIMEOUT_MS=5000
IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
MAX_ROWS=1000
MAX_SQL_LENGTH=10000

# Schema used to qualify unqualified allow-list entries and table references
DEFAULT_SCHEMA=public

# Allow-lists (unset = no table/column restriction beyond read-only)
# ALLOWED_TABLES=film,category
# ALLOWED_COLUMNS=film.title,film.length,category.name

# Auth0 dev tenant — or use the local mock issuer
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
